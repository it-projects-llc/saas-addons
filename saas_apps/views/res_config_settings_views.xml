<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.apps</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_settings']" position="after">
                <block title="SaaS pricing page" name="apps_general_settings">
                    <setting id="show_packages_setting" string="Show packages" help="Show packages at &quot;price&quot; page">
                        <field name="show_packages" class="fw-bold"/>
                        <label for="show_packages"/>
                    </setting>
                    <setting id="show_apps_setting" string="Show apps" help="Show applications at &quot;price&quot; page">
                        <field name="show_apps" class="fw-bold"/>
                        <label for="show_apps"/>
                    </setting>
                    <setting id="show_buy_now_button_setting" string="Show 'Buy now' button">
                        <field name="show_buy_now_button" class="fw-bold"/>
                        <label for="show_buy_now_button"/>
                    </setting>
                    <setting id="show_try_trial_button_setting" string="Show 'Try trial' button">
                        <field name="show_try_trial_button" class="fw-bold"/>
                        <label for="show_try_trial_button"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
