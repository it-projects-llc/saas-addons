<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="saas_apps.ListView.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
        <xpath expr="." position="inside">
            <button type="button" class="btn btn-secondary o_refresh_apps_button" title="Reload apps from this instance"
                    t-on-click="() => this.onRefreshApps()">
                Refresh
            </button>
        </xpath>
    </t>
</templates>
