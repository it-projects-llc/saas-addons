<odoo>
    <record id="saas_operator_form_view" model="ir.ui.view">
        <field name="name">saas.operator.form</field>
        <field name="model">saas.operator</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_show_builds"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list">
                            <field
                                string="Builds"
                                name="build_count"
                                widget="statinfo"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Client Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                        <field name="type"/>
                        <field name="domain_build"/>
                        <field name="db_url_template"/>
                        <field name="global_url"/>
                        </group>
                        <group>
                            <field name="max_databases"/>
                            <field name="cpu_cores"/>
                            <field name="ram_size"/>
                            <field name="storage_size"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="state"/>
                        </group>
                        <group>
                           <!-- <field name="used_databases"/>-->
                            <field name="load_percentage"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="saas_operator_tree_view" model="ir.ui.view">
        <field name="name">saas.operator.tree</field>
        <field name="model">saas.operator</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="max_databases"/>
                <field name="cpu_cores"/>
                <field name="ram_size"/>
                <field name="storage_size"/>
                <field name="used_databases"/>
                <field name="load_percentage"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
</odoo>
