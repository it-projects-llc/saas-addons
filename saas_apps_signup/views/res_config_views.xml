<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.saas.apps.signup</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="saas.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='saas_defaults_container']" position="inside">
                <setting id="database_limit_size_default_setting" string="Database limit size (default)" company_dependent="1">
                    <field name="database_limit_size_default" class="fw-bold"/>
                </setting>
                <setting id="database_expiration_warning_delay_setting" string="Database expiration warning delay (default)">
                    <field name="database_expiration_warning_delay" class="fw-bold"/>
                </setting>
                <setting id="number_of_days_for_trial_setting" string="Number of days for trial (default)">
                    <field name="number_of_days_for_trial" class="fw-bold"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
