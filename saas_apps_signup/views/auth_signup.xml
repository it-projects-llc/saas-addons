<odoo>
    <template id="additional_fields" inherit_id="auth_signup.signup" name="Auth Signup additional form fields">

        <xpath expr="//div[hasclass('field-login')]" position="after">
            <input type="hidden" name="operator_id" t-att-value="operator_id" t-if="operator_id"/>

            <div class="loader hid transition" t-if="operator_id">
                <img src="/saas_apps/static/src/img/loader.gif" draggable="false" alt=""/>
                <p class="status">Creating database...</p>
            </div>

            <div class="mb-3 field-company_name">
                <label for="company_name" class="form-label">Company name</label>
                <input type="text" name="company_name" id="company_name" class="form-control"
                       t-att-value="company_name"
                       required="required"/>
            </div>

            <div class="mb-3 field-database_name" t-if="operator_id">
                <label for="database_name" class="form-label">Database name</label>
                <input type="text" name="database_name" id="database_name" class="form-control"
                       t-att-value="database_name"
                       required="required"/>
                <small id="build-domain-helper">
                    <span class="text-danger build-domain-helper_status build-domain-helper_status-false" style="display: none">Domain is not available</span>
                    <span class="text-success build-domain-helper_status build-domain-helper_status-true" style="display: none">
                        Your domain
                        <span class="domain"></span>
                    </span>
                    <span class="build-domain-helper_status build-domain-helper_status-loading" style="display: none">Detecting is domain available</span>
                </small>
            </div>

            <div class="mb-3 field-phone">
                <label for="phone" class="form-label">Phone</label>
                <input type="text" name="phone" id="phone" class="form-control"
                       t-att-value="phone"
                       required="required"/>
            </div>

            <div class="mb-3 field-database_lang">
                <label for="database_lang" class="form-label">Administrator language</label>
                <select id="database_lang" name="database_lang" class="form-select" autocomplete="off" required="required">
                    <option value=""></option>
                    <t t-foreach="langs" t-as="item">
                        <option t-att-value="item[0]" t-out="item[1]" t-att-selected="'selected' if database_lang == item[0] or (database_lang is None and item[0] == 'en_US') else None"/>
                    </t>
                </select>
            </div>

            <fieldset class="mb-3 field-database_languages" t-if="is_saas_signup">
                <legend class="form-label fs-6" id="database_languages_label">Languages to install</legend>
                <input type="search" id="database_language_search" class="form-control mb-2"
                       placeholder="Search languages..." aria-label="Search languages"/>
                <div class="saas-language-list border rounded p-2" aria-labelledby="database_languages_label">
                    <div t-foreach="langs" t-as="item" class="form-check js-database-language-option">
                        <input type="checkbox" name="database_languages" class="form-check-input"
                               t-att-id="'database_language_' + item[0]" t-att-value="item[0]"
                               t-att-checked="item[0] in database_languages or item[0] == 'en_US' or item[0] == (database_lang or 'en_US')"/>
                        <label class="form-check-label" t-att-for="'database_language_' + item[0]" t-out="item[1]"/>
                    </div>
                </div>
                <small class="form-text text-muted">English and your preferred language are included automatically.</small>
            </fieldset>

            <div class="mb-3 field-country_code">
                <label for="country_code" class="form-label">Country</label>
                <select id="country_code" name="country_code" class="form-select" autocomplete="off" required="required">
                    <option value=""></option>
                    <t t-foreach="countries" t-as="item">
                        <option t-att-value="item[0]" t-out="item[1]" t-att-selected="'selected' if country_code == item[0] else None"/>
                    </t>
                </select>
            </div>
        </xpath>
    </template>

</odoo>
