<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <template id="portal_table_builds" name="Table of builds">
        <t t-if="builds" t-call="portal.portal_table">
            <tbody>
                <tr t-foreach="builds" t-as="build">
                    <td>
                        <span class="float-start">
                            <a t-attf-href="/my/build/#{build.id}?{{ keep_query() }}"><span t-field="build.name" /></a>
                            <t t-if="build.admin_user != user_id">
                                (Admin: <t t-if="not build.admin_user">None</t><t t-else="" t-out="build.admin_user.name" />)
                            </t>
                        </span>
                        <span class="float-end">
                            <t t-if="build.state == 'done'">
                                <a role="button" t-att-href="build.get_url()" class="btn btn-sm btn-secondary" target="_blank">
                                    Link
                                </a>
                            </t>
                        </span>
                    </td>
                </tr>
            </tbody>
        </t>
    </template>

    <template id="portal_my_builds" name="My Builds">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Builds</t>
            </t>
            <t t-if="not builds">
                <div class="alert alert-warning mt8" role="alert">
                    There are no builds
                </div>
            </t>
            <t t-call="saas_portal.portal_table_builds" />
            <t t-if="temporary_builds">
                <br />
                <h3>Temporary builds</h3>
                <t t-call="saas_portal.portal_table_builds">
                    <t t-set="builds" t-value="temporary_builds" />
                </t>
            </t>
        </t>
    </template>

    <template id="portal_my_build" name="My Build">
        <t t-call="portal.portal_layout">
            <t t-set="pending_jobs" t-value="build.number_of_queue_jobs_to_be_done" /><section class="card mb-4 js_saas_build_status" t-att-data-build-id="build.id" t-att-data-ready="'true' if build.state == 'done' and not pending_jobs else 'false'">
                <t t-set="card_header">
                    <h5 class="mb-0 d-flex flex-wrap align-items-center gap-2">
                        <small class="text-muted">Build - </small><span t-field="build.name" />
                        <span t-att-hidden="build.state != 'draft'" data-build-draft="">(Draft)</span>
                        <span class="ms-auto d-flex align-items-center gap-2">
                            <t t-if="build.is_temporary">
                                <a class="btn btn-sm" disabled="disabled" t-if="build.is_approved">
                                    Approved
                                </a>
                                <form t-else="" style="display: inline-block" t-att-action="build.get_portal_url(suffix='/approve')" method="POST">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                                    <input class="btn btn-sm btn-secondary" type="submit" value="Approve" />
                                </form>
                            </t>
                            <t>
                                <a role="button" t-att-href="build.get_url() if build.state == 'done' and not pending_jobs else None" class="btn btn-sm btn-secondary" target="_blank" t-att-hidden="build.state != 'done' or bool(pending_jobs)" data-build-link="" rel="noopener">
                                    Link
                                </a>
                            </t>
                        </span>
                    </h5>
                </t>
                <t t-set="card_body">
                    <div class="row">
                        <div class="col">
                            <b>Expiration date</b>
                        </div>
                        <div class="col">
                            <span t-field="build.expiration_date" data-build-expiration="" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <b>Number of users</b>
                        </div>
                        <div class="col">
                            <span t-field="build.users_count" data-build-users="" /> / <span t-field="build.max_users_limit" data-build-limit="" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <b>Pending processes</b>
                        </div>
                        <div class="col">
                            <span t-out="pending_jobs" data-build-pending="" />
                        </div>
                    </div>
                </t>
            <div class="card-header"><t t-out="card_header" /></div><div class="card-body"><t t-out="card_body" /></div></section>
        </t>
    </template>

    <template id="approve_build_result" name="Approve build result">
        <t t-call="portal.portal_layout">
            <t t-if="error">
                <div class="alert alert-danger">
                    <t t-out="error" />
                </div>
                <t t-if="details">
                    <pre><t t-out="details" /></pre>
                </t>
            </t>
            <t t-else="">
                <div class="alert alert-success">
                    This build is marked as approved successfully. Please wait for some time, until admin sets this build as main.
                </div>
                <a class="btn btn-primary" t-att-href="build.get_portal_url()">Go back to build</a>
            </t>
        </t>
    </template>
</odoo>